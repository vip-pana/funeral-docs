{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "funeral-docs",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-sections": [
        { "type": "feat", "section": "Funzionalità" },
        { "type": "fix", "section": "Correzioni" },
        { "type": "perf", "section": "Prestazioni" },
        { "type": "docs", "section": "Documentazione" },
        { "type": "build", "section": "Build" },
        { "type": "ci", "section": "CI" },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "chore", "section": "Manutenzione", "hidden": true },
        { "type": "test", "section": "Test", "hidden": true }
      ]
    }
  }
}
