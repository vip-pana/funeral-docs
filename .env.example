# Copia in .env e riempi i valori. Il .env non va nel repo.

# Password di accesso iniziale, come hash bcrypt.
#   pnpm auth:hash 'la-tua-password'
# Lo script stampa la riga gia' pronta. I `\$` sono obbligatori: senza,
# il parser .env espande `$2b` come variabile e l'hash arriva troncato.
#
# Serve solo al primo avvio: la password viene copiata da qui nel database e
# poi si cambia da Impostazioni. Da quel momento questa riga viene ignorata.
AUTH_PASSWORD_HASH="\$2b\$12\$..."

# Firma dei cookie di sessione. Almeno 32 caratteri.
#   openssl rand -base64 32
# Cambiarla invalida tutte le sessioni attive.
SESSION_SECRET=

# Cookie di sessione solo su https. Va messo a false quando si accede in http
# — per esempio dall'indirizzo Tailscale (100.x.y.z): il browser fa
# un'eccezione per localhost ma non per un IP, e con secure attivo il cookie
# non verrebbe memorizzato, rendendo impossibile l'accesso.
# Default: true in produzione, false in sviluppo.
# COOKIE_SECURE=false

# Percorso del database SQLite.
# In produzione punta al volume montato: se il file manca, l'avvio fallisce
# invece di creare un database vuoto che sembrerebbe solo nuovo.
DATABASE_PATH=./data/funeral.db

# Cartella dei template .docx. Da valorizzare solo se i template stanno fuori
# dal progetto (vedi DECISIONI-APERTE.md, punto 1).
# TEMPLATES_DIR=/app/templates
