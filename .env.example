# Copia in .env e riempi i valori. Il .env non va nel repo.

# Password di accesso iniziale, come hash bcrypt.
#   pnpm auth:hash 'la-tua-password'
# Lo script stampa la riga gia' pronta. I `\$` sono obbligatori: senza,
# il parser .env espande `$2b` come variabile e l'hash arriva troncato.
#
# Serve solo al primo avvio: la password viene copiata da qui nel database e
# poi si cambia da Impostazioni. Da quel momento questa riga viene ignorata.
AUTH_PASSWORD_HASH="\$2b\$12\$..."

# Firma dei cookie di sessione. Almeno 32 caratteri.
#   openssl rand -base64 32
# Cambiarla invalida tutte le sessioni attive.
SESSION_SECRET=

# Cookie di sessione solo su https. Con `tailscale serve` davanti (come su
# Victus) va lasciato a true: si accede a un nome con certificato valido.
#
# Va messo a false solo se si accede in http — per esempio direttamente
# all'indirizzo Tailscale (100.x.y.z): il browser fa un'eccezione per localhost
# ma non per un IP, e con secure attivo il cookie non verrebbe memorizzato,
# rendendo impossibile l'accesso.
# Default: true in produzione, false in sviluppo.
# COOKIE_SECURE=false

# Indirizzo su cui il container pubblica la porta, solo in produzione.
# Con `tailscale serve` davanti lasciare 127.0.0.1: serve raggiunge l'app su
# loopback e la espone in https, senza che il container sia raggiungibile
# direttamente. Senza serve, va messo all'indirizzo tailnet (`tailscale ip -4`).
# BIND_ADDRESS=127.0.0.1

# Percorso del database SQLite.
# In produzione punta al volume montato: se il file manca, l'avvio fallisce
# invece di creare un database vuoto che sembrerebbe solo nuovo.
DATABASE_PATH=./data/funeral.db

# Cartella dei template .docx. Da valorizzare solo se i template stanno fuori
# dal progetto (vedi DECISIONI-APERTE.md, punto 1).
# TEMPLATES_DIR=/app/templates

# Auth key del nodo Tailscale dedicato (il sidecar in docker-compose.prod.yml).
# Generane una su https://login.tailscale.com/admin/settings/keys con
# Reusable attivo e Ephemeral disattivo: il nodo deve restare registrato anche a
# container fermo, altrimenti il nome slitta a funeral-docs-1 a ogni ricreazione.
# TS_AUTHKEY=tskey-auth-...
